{
	"name": "aweft-monorepo",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.12.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"typecheck": "tsc --build",
		"deps": "depcruise packages --config .dependency-cruiser.cjs",
		"fixtures": "node packages/testing/scripts/generate-fixtures.ts",
		"proofs": "node examples/codec/main.ts && node examples/core/main.ts && node examples/schema/main.ts",
		"bench": "node bench/derived.ts && node bench/write.ts",
		"test": "npm run typecheck && npm run deps && npm run boundaries && npm run dependencies && node packages/testing/scripts/run-tests.ts && npm run proofs",
		"gate": "npm test",
		"boundaries": "node packages/testing/scripts/check-boundaries.ts",
		"dependencies": "node packages/testing/scripts/check-dependencies.ts"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"dependency-cruiser": "^16.10.0",
		"typescript": "^5.9.2"
	}
}
