{
	"name": "@aweftjs/icons",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/icons"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "Icon sets as modules: one icon at build time, a whole set, the standard names, and a resolver for a name known only at run time.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"aweft-source": "./src/node.ts",
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/ui": "^0.1.0"
	},
	"peerDependencies": {
		"@iconify-json/lucide": "^1.2.0"
	},
	"peerDependenciesMeta": {
		"@iconify-json/lucide": {
			"optional": true
		}
	},
	"devDependencies": {
		"@aweftjs/testing": "^0.1.0",
		"@iconify-json/lucide": "^1.2.0"
	},
	"aweft": {
		"tier": 7,
		"branchCoverage": 80
	},
	"publishConfig": {
		"access": "public"
	}
}
