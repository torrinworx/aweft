{
	"name": "@aweftjs/uploads",
	"version": "0.1.1",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/uploads"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "The uploads battery: a file from a page or a module, kept as bytes in a directory or an S3-compatible bucket and as a record in the application's store, served back at /files/<id>, with the application's rules in configuration.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"aweft-source": "./src/client.ts",
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./s3": {
			"aweft-source": "./src/s3.ts",
			"types": "./dist/s3.d.ts",
			"default": "./dist/s3.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --import @aweftjs/build/loader --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.1",
		"@aweftjs/core": "^0.1.1",
		"@aweftjs/modules": "^0.1.1",
		"@aweftjs/store": "^0.1.1"
	},
	"devDependencies": {
		"@aweftjs/auth": "^0.1.1",
		"@aweftjs/build": "^0.1.1",
		"@aweftjs/server": "^0.1.1",
		"@aweftjs/static": "^0.1.1",
		"@aweftjs/testing": "^0.1.1"
	},
	"aweft": {
		"tier": "integrator",
		"branchCoverage": 80
	},
	"publishConfig": {
		"access": "public"
	}
}
