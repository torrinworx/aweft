		"@aweftjs/build": "^0.1.0",
		"@aweftjs/server": "^0.1.0",
		"@aweftjs/store": "^0.1.0"
	},
	"aweft": {
		"tier": "integrator",
		"branchCoverage": 80
	},
	"publishConfig": {
		"access": "public"
