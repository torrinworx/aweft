{
	"name": "@aweftjs/health",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/health"
	},
	"files": [
		"dist",
		"src",
		"README.md",
