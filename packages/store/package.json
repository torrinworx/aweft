{
	"name": "@aweftjs/store",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/store"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "Persistence: observable rows, a bounded commit tail, and the driver interface.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./postgres": {
			"aweft-source": "./src/postgres.ts",
			"types": "./dist/postgres.d.ts",
			"default": "./dist/postgres.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/core": "^0.1.0"
	},
	"devDependencies": {
		"@aweftjs/testing": "^0.1.0",
		"@types/pg": "^8.23.1",
		"embedded-postgres": "^18.4.0-beta.17",
		"pg": "^8.23.0"
	},
	"aweft": {
		"tier": 4,
		"branchCoverage": 90
	},
	"publishConfig": {
		"access": "public"
	}
}
