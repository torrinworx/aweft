{
	"name": "@aweftjs/testing",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/testing"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "Conformance runners and harnesses the rest of the stack is checked with.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./postgres": {
			"aweft-source": "./src/postgres.ts",
			"types": "./dist/postgres.d.ts",
			"default": "./dist/postgres.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/modules": "^0.1.0",
		"@aweftjs/sandbox": "^0.1.0",
		"@aweftjs/server": "^0.1.0",
		"@aweftjs/sync": "^0.1.0",
		"typescript": "^5.9.2",
		"@aweftjs/dom": "^0.1.0"
	},
	"aweft": {
		"tier": "integrator",
		"branchCoverage": 80
	},
	"devDependencies": {
		"embedded-postgres": "^18.4.0-beta.17",
		"pg": "^8.23.0",
		"@types/pg": "^8.23.1"
	},
	"peerDependencies": {
		"embedded-postgres": "^18.4.0-beta.17",
		"pg": "^8.23.0"
	},
	"peerDependenciesMeta": {
		"embedded-postgres": {
			"optional": true
		},
		"pg": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
