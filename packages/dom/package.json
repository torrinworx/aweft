{
	"name": "@aweftjs/dom",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/dom"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "The DOM binding: mount, static render and hydration as modes of one path.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./router": {
			"aweft-source": "./src/router.ts",
			"types": "./dist/router.d.ts",
			"default": "./dist/router.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/core": "^0.1.0"
	},
	"devDependencies": {
		"@aweftjs/testing": "^0.1.0"
	},
	"aweft": {
		"tier": 6,
		"branchCoverage": 90
	},
	"publishConfig": {
		"access": "public"
	}
}
