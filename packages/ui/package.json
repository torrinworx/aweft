{
	"name": "@aweftjs/ui",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/ui"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "Components and theming: a wrapping h, the theme engine, contexts, popups, suspend and marks.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./countries": {
			"aweft-source": "./src/countries.ts",
			"types": "./dist/countries.d.ts",
			"default": "./dist/countries.js"
		},
		"./icon-names": {
			"aweft-source": "./src/icon-names.ts",
			"types": "./dist/icon-names.d.ts",
			"default": "./dist/icon-names.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --import @aweftjs/build/loader --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/core": "^0.1.0",
		"@aweftjs/dom": "^0.1.0",
		"@aweftjs/modules": "^0.1.0"
	},
	"peerDependencies": {
		"country-region-data": "^3.1.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"country-region-data": {
			"optional": true
		}
	},
	"devDependencies": {
		"@aweftjs/build": "^0.1.0",
		"@aweftjs/testing": "^0.1.0",
		"country-region-data": "^4.1.0"
	},
	"aweft": {
		"tier": 7,
		"branchCoverage": 80
	},
	"publishConfig": {
		"access": "public"
	}
}
