{
	"name": "@aweftjs/build",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/build"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "One transform, two modes: markup and JSX to h calls, static subtrees to templates, asserts out of a release build.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./loader": {
			"aweft-source": "./src/loader.ts",
			"types": "./dist/loader.d.ts",
			"default": "./dist/loader.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --import @aweftjs/build/loader --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/icons": "^0.1.0",
		"@babel/parser": "^7.28.4",
		"magic-string": "^0.30.19"
	},
	"devDependencies": {
		"@aweftjs/dom": "^0.1.0",
		"@aweftjs/core": "^0.1.0",
		"@aweftjs/ui": "^0.1.0",
		"@aweftjs/testing": "^0.1.0"
	},
	"aweft": {
		"tier": "integrator",
		"branchCoverage": 80
	},
	"publishConfig": {
		"access": "public"
	}
}
