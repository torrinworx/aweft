{
	"name": "@aweftjs/client",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/client"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "One connection to an aweft server for the life of a page: the socket, the link and the requests attached before it opens, and the same documents back after a drop.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/core": "^0.1.0",
		"@aweftjs/sync": "^0.1.0"
	},
	"devDependencies": {
		"@aweftjs/modules": "^0.1.0",
		"@aweftjs/server": "^0.1.0",
		"@aweftjs/testing": "^0.1.0"
	},
	"aweft": {
		"tier": 6,
		"branchCoverage": 80
	},
	"publishConfig": {
		"access": "public"
	}
}
