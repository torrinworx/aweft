{
	"name": "@aweftjs/server",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/server"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "Connections and requests behind a gate: a listener the application supplies, one socket carrying a sync link and a call channel, and the modules' hooks run for whoever the gate allows.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"aweft-source": "./src/node.ts",
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/core": "^0.1.0",
		"@aweftjs/modules": "^0.1.0",
		"@aweftjs/sync": "^0.1.0",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@aweftjs/testing": "^0.1.0",
		"@types/ws": "^8.18.1"
	},
	"aweft": {
		"tier": 6,
		"branchCoverage": 80
	},
	"publishConfig": {
		"access": "public"
	}
}
