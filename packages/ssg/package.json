{
	"name": "@aweftjs/ssg",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/ssg"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "Pages from a routed site, at build time and at run time: walk the acts, write the files, take the markup over in the browser.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"aweft-source": "./src/client.ts",
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --import @aweftjs/build/loader --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/dom": "^0.1.0",
		"@aweftjs/ui": "^0.1.0"
	},
	"devDependencies": {
		"@aweftjs/build": "^0.1.0",
		"@aweftjs/core": "^0.1.0",
		"@aweftjs/testing": "^0.1.0"
	},
	"aweft": {
		"tier": "integrator",
		"branchCoverage": 80
	},
	"publishConfig": {
		"access": "public"
	}
}
