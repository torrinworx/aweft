{
	"name": "@aweftjs/auth",
	"version": "0.1.1",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/auth"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt",
		"text.json"
	],
	"description": "The first battery: a gate that reads public, sessions as documents, sign-in and sign-up by email and password, and a per-user state document, as server modules, with the page half as client modules.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"aweft-source": "./src/client.ts",
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./text.json": "./text.json"
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --import @aweftjs/build/loader --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/client": "^0.1.1",
		"@aweftjs/codec": "^0.1.1",
		"@aweftjs/core": "^0.1.1",
		"@aweftjs/modules": "^0.1.1",
		"@aweftjs/server": "^0.1.1",
		"@aweftjs/store": "^0.1.1",
		"@aweftjs/ui": "^0.1.1"
	},
	"devDependencies": {
		"@aweftjs/build": "^0.1.1",
		"@aweftjs/notify": "^0.1.1",
		"@aweftjs/sync": "^0.1.1",
		"@aweftjs/testing": "^0.1.1"
	},
	"aweft": {
		"tier": "integrator",
		"branchCoverage": 80
	},
	"publishConfig": {
		"access": "public"
	}
}
