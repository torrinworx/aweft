{
	"name": "@aweftjs/sandbox",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/torrinworx/aweft.git",
		"directory": "packages/sandbox"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"surface.txt",
		"errors.txt"
	],
	"description": "A room for modules the host does not trust: a loader on the far end of a link, fed a module document, props and granted names, and the runners that make the room.",
	"exports": {
		".": {
			"aweft-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./inside": {
			"aweft-source": "./src/inside.ts",
			"types": "./dist/inside.d.ts",
			"default": "./dist/inside.js"
		},
		"./node": {
			"aweft-source": "./src/node.ts",
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		},
		"./page": {
			"aweft-source": "./src/page.tsx",
			"types": "./dist/page.d.ts",
			"default": "./dist/page.js"
		},
		"./room": {
			"aweft-source": "./src/room.tsx",
			"types": "./dist/room.d.ts",
			"default": "./dist/room.js"
		}
	},
	"scripts": {
		"prepack": "node ../build/scripts/build-package.ts",
		"test": "node --import @aweftjs/build/loader --test tests/*.test.ts"
	},
	"dependencies": {
		"@aweftjs/client": "^0.1.0",
		"@aweftjs/codec": "^0.1.0",
		"@aweftjs/core": "^0.1.0",
		"@aweftjs/dom": "^0.1.0",
		"@aweftjs/modules": "^0.1.0",
		"@aweftjs/sync": "^0.1.0",
		"@aweftjs/ui": "^0.1.0"
	},
	"devDependencies": {
		"@aweftjs/build": "^0.1.0",
		"@aweftjs/testing": "^0.1.0",
		"playwright": "^1.62.1"
	},
	"aweft": {
		"tier": 7,
		"branchCoverage": 90
	},
	"publishConfig": {
		"access": "public"
	}
}
